# ============================================================
# Aegis 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- OpenAI 兼容 API (必填) ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
DEFAULT_MODEL=deepseek-v4-pro
EMBEDDING_MODEL=text-embedding-3-small

# --- 可选: 其他 LLM 提供商 ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# --- 向量数据库 ---
CHROMA_PERSIST_DIR=./data/chroma_db
# FAISS_INDEX_DIR=./data/faiss_index

# --- 文件记忆存储 (Markdown 文件) ---
MEMORY_FILE_DIR=./data/memory

# --- 搜索 API (可选) ---
# SERPAPI_API_KEY=
# TAVILY_API_KEY=your-tavily-api-key-here

# --- 邮件 (可选, 用于邮件提醒) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- 日志 ---
LOG_LEVEL=INFO

# --- 数据目录 ---
AEGIS_DATA_DIR=./data

# --- Web API 认证 (可选) ---
# AEGIS_AUTH_MODE=or            # off | or | and
# AEGIS_IP_WHITELIST=127.0.0.1,10.0.0.0/8
# AEGIS_API_KEYS=your-api-key-1,your-api-key-2

# --- Web API 网络 (可选) ---
# AEGIS_PORT=7860
# AEGIS_DEV_MODE=true
# AEGIS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# AEGIS_TRUSTED_PROXIES=127.0.0.1
# AEGIS_HSTS=false
# AEGIS_ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.pptx,.xlsx,.csv,.png,.jpg,.mp3,.wav,.flac,.m4a

# --- MCP 服务端点 (可选) ---
# MCP_SEARCH_ENDPOINT=http://localhost:8001
# MCP_TRANSLATION_ENDPOINT=http://localhost:8002
# MCP_CALENDAR_ENDPOINT=http://localhost:8003
